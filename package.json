{
  "name": "pinkbook-manager",
  "version": "1.0.0",
  "description": "Hệ thống Quản lý Cửa hàng Sách - PinkBook Manager (Nhóm 33)",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/runtime.test.js && npm run build",
    "dev": "node scripts/dev.js",
    "stop": "node scripts/stop.js",
    "migrate:data-local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/migrate-data-local.ps1",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build --config frontend/vite.config.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/restore.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@supabase/supabase-js": "^2.118.0",
    "express": "5.3.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "vite": "8.3.5"
  }
}
